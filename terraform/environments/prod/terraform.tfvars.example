# PETPLAT-1: prod variable values.
#
# Copy to terraform.tfvars (which is gitignored per security rule 8) and adjust:
#   cp terraform.tfvars.example terraform.tfvars

aws_region         = "eu-central-1"
environment        = "prod"
project            = "petclinic"
availability_zones = ["eu-central-1a", "eu-central-1b"]

# Networking (PETPLAT-10) — non-overlapping with dev's 10.0.0.0/16
vpc_cidr            = "10.1.0.0/16"
public_subnet_cidrs = ["10.1.1.0/24", "10.1.2.0/24"]
